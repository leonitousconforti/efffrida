    },
    "devDependencies": {
        "@effect/platform-node": "4.0.0-rc.118",
        "@effect/tsgo": "0.46.1",
        "@effect/vitest": "4.0.0-rc.118",
        "@efffrida/polyfills": "latest",
        "@efffrida/vitest-pool": "latest",
        "@types/frida-gum": "19.11.0",
        "@types/node": "26.6.3",
        "@vitest/utils": "5.0.2",
        "birpc": "4.2.0",
        "flatted": "3.4.4",
        "frida": "17.19.0",
        "oxfmt": "0.70.0",
        "oxlint": "1.85.0",
        "oxlint-tsgolint": "7.0.2003",
        "redis": "6.2.1",
        "typescript": "7.0.2",
