{
    "name": "app-and-agent",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "effect-tsgo patch --typescript --oxlint",
        "build": "tsc -b tsconfig.build.json",
        "check": "tsc -b tsconfig.json",
        "lint": "oxlint && oxfmt --check frida node shared",
        "lint-fix": "oxlint --fix && oxfmt --write frida node shared",
        "test": "vitest"
