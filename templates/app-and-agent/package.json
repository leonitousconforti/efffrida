{
    "name": "app-and-agent",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "effect-tsgo patch --typescript --oxlint",
        "build": "tsc -b tsconfig.build.json",
        "check": "tsc -b tsconfig.json",
        "lint": "oxlint && oxfmt --check frida node shared",
        "lint-fix": "oxlint --fix && oxfmt --write frida node shared",
        "test": "vitest",
        "coverage": "vitest --coverage"
    },
    "dependencies": {
        "@efffrida/frida-tools": "latest",
        "@efffrida/platform": "latest",
        "@efffrida/rpc": "latest",
        "effect": "4.0.0-rc.115"
    },
    "devDependencies": {
        "@effect/platform-node": "4.0.0-rc.115",
        "@effect/tsgo": "0.45.0",
        "@effect/vitest": "4.0.0-rc.115",
        "@efffrida/polyfills": "latest",
        "@efffrida/vitest-pool": "latest",
        "@types/frida-gum": "19.10.0",
        "@types/node": "25.9.7",
        "@vitest/coverage-v8": "5.0.1",
        "@vitest/runner": "4.1.11",
        "@vitest/utils": "5.0.1",
        "birpc": "4.2.0",
        "flatted": "3.4.4",
        "frida": "17.18.0",
        "oxfmt": "0.67.0",
        "oxlint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "redis": "6.2.1",
        "typescript": "7.0.2",
        "vite": "8.2.2",
        "vitest": "5.0.1"
    },
    "peerDependencies": {
        "effect": "4.0.0-rc.115"
    }
}
