{
    "name": "agent-only",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts"
    },
    "scripts": {
        "prepare": "effect-tsgo patch --typescript --oxlint",
        "build": "tsc -b tsconfig.build.json",
        "check": "tsc -b tsconfig.json",
        "lint": "oxlint && oxfmt --check src test",
        "lint-fix": "oxlint --fix && oxfmt --write src test",
        "test": "vitest"
    },
    "dependencies": {
        "@efffrida/platform": "latest",
        "effect": "4.1.2"
    },
    "devDependencies": {
        "@effect/tsgo": "0.67.4",
        "@effect/vitest": "4.1.2",
        "@efffrida/polyfills": "latest",
        "@efffrida/vitest-pool": "latest",
        "@types/frida-gum": "19.13.0",
        "@types/node": "26.6.6",
        "@vitest/utils": "5.1.0",
        "birpc": "4.2.0",
        "flatted": "3.4.4",
        "oxfmt": "0.76.0",
        "oxlint": "1.91.0",
        "oxlint-tsgolint": "7.0.2005",
        "typescript": "7.0.2",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    },
    "peerDependencies": {
        "effect": "4.1.2"
    },
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
