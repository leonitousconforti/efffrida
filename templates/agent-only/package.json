{
    "name": "agent-only",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts"
    },
    "scripts": {
        "prepare": "effect-tsgo patch --typescript --oxlint",
        "build": "tsc -b tsconfig.build.json",
        "check": "tsc -b tsconfig.json",
        "lint": "oxlint && oxfmt --check src test",
        "lint-fix": "oxlint --fix && oxfmt --write src test",
        "test": "vitest"
    },
    "dependencies": {
        "@efffrida/platform": "latest",
        "effect": "4.1.4"
    },
    "devDependencies": {
        "@effect/tsgo": "0.73.2",
        "@effect/vitest": "4.1.4",
        "@efffrida/polyfills": "latest",
        "@efffrida/vitest-pool": "latest",
        "@types/frida-gum": "19.13.0",
        "@types/node": "26.6.6",
        "@vitest/utils": "5.1.1",
        "birpc": "4.2.0",
        "flatted": "3.4.4",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "oxlint-tsgolint": "7.0.2007",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "peerDependencies": {
        "effect": "4.1.4"
    },
    "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
