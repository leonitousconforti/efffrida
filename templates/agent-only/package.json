{
    "name": "agent-only",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts"
    },
    "scripts": {
        "prepare": "effect-tsgo patch --typescript --oxlint",
        "build": "tsc -b tsconfig.build.json",
        "check": "tsc -b tsconfig.json",
        "lint": "oxlint && oxfmt --check src",
        "lint-fix": "oxlint --fix && oxfmt --write src",
        "test": "vitest"
    },
    "dependencies": {
        "@efffrida/platform": "latest",
        "effect": "4.0.0-rc.118"
    },
    "devDependencies": {
        "@effect/tsgo": "0.47.2",
        "@effect/vitest": "4.0.0-rc.118",
        "@efffrida/polyfills": "latest",
        "@efffrida/vitest-pool": "latest",
        "@types/frida-gum": "19.12.0",
        "@types/node": "26.6.4",
        "@vitest/utils": "5.0.2",
        "birpc": "4.2.0",
        "flatted": "3.4.4",
        "oxfmt": "0.71.0",
        "oxlint": "1.86.0",
        "oxlint-tsgolint": "7.0.2003",
        "typescript": "7.0.2",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    },
    "peerDependencies": {
        "effect": "4.0.0-rc.118"
    }
}
