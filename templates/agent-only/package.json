{
    "name": "agent-only",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts"
    },
    "scripts": {
        "prepare": "effect-tsgo patch --typescript --oxlint",
        "build": "tsc -b tsconfig.build.json",
        "check": "tsc -b tsconfig.json",
        "lint": "oxlint && oxfmt --check src test",
        "lint-fix": "oxlint --fix && oxfmt --write src test",
        "test": "vitest"
    },
    "dependencies": {
        "@efffrida/platform": "latest",
        "effect": "4.1.0"
    },
    "devDependencies": {
        "@effect/tsgo": "0.63.0",
        "@effect/vitest": "4.1.0",
        "@efffrida/polyfills": "latest",
        "@efffrida/vitest-pool": "latest",
        "@types/frida-gum": "19.12.0",
        "@types/node": "26.6.6",
        "@vitest/utils": "5.0.5",
        "birpc": "4.2.0",
        "flatted": "3.4.4",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "peerDependencies": {
        "effect": "4.1.0"
    },
    "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
