{
    "name": "agent-only",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts"
    },
    "scripts": {
        "prepare": "effect-tsgo patch",
        "build": "tsc -b tsconfig.build.json",
        "check": "tsc -b tsconfig.json",
        "lint": "oxlint && oxfmt --check src",
        "lint-fix": "oxlint --fix && oxfmt --write src",
        "test": "vitest",
        "coverage": "vitest --coverage"
    },
    "dependencies": {
        "@efffrida/platform": "latest",
        "effect": "4.0.0-beta.104"
    },
    "devDependencies": {
        "@effect/platform-node": "4.0.0-beta.104",
        "@effect/tsgo": "0.33.0",
        "@effect/vitest": "4.0.0-beta.104",
        "@efffrida/polyfills": "latest",
        "@efffrida/vitest-pool": "latest",
        "@types/frida-gum": "19.10.0",
        "@types/node": "25.9.5",
        "@vitest/coverage-v8": "4.1.10",
        "@vitest/runner": "4.1.10",
        "@vitest/utils": "4.1.10",
        "birpc": "4.0.0",
        "flatted": "3.4.4",
        "ioredis": "5.11.1",
        "oxfmt": "0.62.0",
        "oxlint": "1.77.0",
        "typescript": "7.0.2",
        "vite": "8.2.0",
        "vitest": "4.1.10"
    },
    "peerDependencies": {
        "effect": "4.0.0-beta.104"
    }
}
