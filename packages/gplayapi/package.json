{
    "name": "@efffrida/gplayapi",
    "version": "0.0.37",
    "description": "Google Play API client for downloading apps",
    "keywords": [
        "effect-ts",
        "frida.re",
        "reverse engineering"
    ],
    "homepage": "https://github.com/leonitousconforti/efffrida",
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "https://github.com/leonitousconforti/efffrida.git",
        "directory": "packages/gplayapi"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map",
        "protobuf/**/*.proto",
        "devices/**/*.properties"
    ],
    "type": "module",
    "sideEffects": [],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "efffrida-src": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./*": {
            "efffrida-src": "./src/*.ts",
            "default": "./dist/*.js"
        },
        "./internal/*": null,
        "./generated/*": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            ".": "./dist/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null,
            "./generated/*": null
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "codegen": "build-utils prepare-v4",
        "build": "tsc -b tsconfig.build.json && pnpm babel",
        "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "check": "tsc -b tsconfig.json",
        "protobuf": "buf generate"
    },
    "dependencies": {
        "@bufbuild/protobuf": "2.16.0"
    },
    "devDependencies": {
        "@bufbuild/buf": "1.75.0",
        "@bufbuild/protoc-gen-es": "2.16.0",
        "@types/node": "26.6.6",
        "effect": "4.1.0"
    },
    "peerDependencies": {
        "effect": "4.1.0"
    },
    "engines": {
        "node": ">=24"
    }
}
