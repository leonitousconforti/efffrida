{
    "name": "@efffrida/rpc",
    "version": "0.0.70",
    "description": "effect/rpc protocols between Node and Frida agents",
    "keywords": [
        "effect-ts",
        "frida.re",
        "reverse engineering"
    ],
    "homepage": "https://github.com/leonitousconforti/efffrida",
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "https://github.com/leonitousconforti/efffrida.git",
        "directory": "packages/rpc"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "type": "module",
    "sideEffects": [],
    "exports": {
        "./package.json": "./package.json",
        "./node": {
            "efffrida-src": "./src/node/index.ts",
            "default": "./dist/node/index.js"
        },
        "./frida": {
            "efffrida-src": "./src/frida/index.ts",
            "default": "./dist/frida/index.js"
        },
        "./*": {
            "efffrida-src": "./src/*.ts",
            "default": "./dist/*.js"
        },
        "./internal/*": null,
        "./frida/internal/*": null,
        "./node/internal/*": null,
        "./shared/*": null,
        "./*/index": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            "./node": "./dist/node/index.js",
            "./frida": "./dist/frida/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null,
            "./frida/internal/*": null,
            "./node/internal/*": null,
            "./shared/*": null,
            "./*/index": null
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "codegen": "build-utils prepare-v4",
        "build": "tsc -b tsconfig.build.json && pnpm babel",
        "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "check": "tsc -b tsconfig.json",
        "test": "vitest"
    },
    "dependencies": {
        "@efffrida/frida-tools": "workspace:*",
        "@efffrida/polyfills": "workspace:*"
    },
    "devDependencies": {
        "@effect/platform-node": "4.1.2",
        "@effect/vitest": "4.1.2",
        "@efffrida/platform": "workspace:*",
        "@types/frida-gum": "19.13.0",
        "@types/node": "26.6.6",
        "effect": "4.1.2",
        "frida": "17.26.2",
        "redis": "6.3.1",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    },
    "peerDependencies": {
        "effect": "4.1.2"
    },
    "engines": {
        "node": ">=24"
    }
}
