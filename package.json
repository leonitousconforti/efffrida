{
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "clean": "node scripts/clean.mjs",
        "codegen": "pnpm --recursive --parallel --filter \"./packages/**/*\" run codegen",
        "build": "tsc -b tsconfig.build.json && pnpm --recursive --parallel --filter \"./packages/**/*\" run build",
        "circular": "node scripts/circular.mjs",
        "test": "vitest",
        "check": "tsc -b tsconfig.json",
        "check:templates": "tsc -b templates/agent-only templates/app-and-agent",
        "check-recursive": "pnpm --recursive --filter \"./packages/**/*\" exec tsc -b tsconfig.json",
        "lint": "oxlint --disable-nested-config && oxfmt --check packages scratchpad scripts templates",
        "lint-fix": "oxlint --disable-nested-config --fix && oxfmt --write packages scratchpad scripts templates",
        "docgen": "pnpm --recursive --filter \"./packages/**/*\" exec docgen && node scripts/docs.mjs",
        "changeset-version": "changeset version",
        "changeset-publish": "pnpm build && changeset publish",
        "prepare": "effect-tsgo patch --typescript --oxlint"
    },
    "devDependencies": {
        "@babel/cli": "8.0.6",
        "@babel/core": "8.0.6",
        "@changesets/cli": "3.0.3",
        "@changesets/config": "4.0.1",
        "@effect/build-utils": "0.8.9",
        "@effect/docgen": "4.0.0-rc.118",
        "@effect/tsgo": "0.46.1",
        "@types/node": "26.6.4",
        "babel-plugin-annotate-pure-calls": "0.5.0",
        "madge": "8.0.0",
        "oxfmt": "0.70.0",
        "oxlint": "1.85.0",
        "oxlint-tsgolint": "7.0.2003",
        "redis": "6.3.0",
        "typescript": "7.0.2",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    },
    "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
